{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.runtime/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "scripts/**/*.mjs"]
}
