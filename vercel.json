{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/compose",
      "destination": "/index.html"
    },
    {
      "source": "/demo/base",
      "destination": "/index.html"
    },
    {
      "source": "/entry/:entryId",
      "destination": "/index.html"
    },
    {
      "source": "/experience/:entryId",
      "destination": "/index.html"
    },
    {
      "source": "/learn/:moduleId",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/not-found",
      "destination": "/index.html"
    }
  ]
}
