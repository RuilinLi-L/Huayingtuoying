SUNO_UPLOAD_BASE_URL=https://sunoapiorg.redpandaai.co
PUBLIC_APP_URL=http://localhost:5173

# 如果第三方 Suno API 的路径与默认值不同，可以用下面几项覆盖。
# SUNO_CALLBACK_URL=https://example.com/api/music/callback
# SUNO_UPLOAD_URL=https://example.com/api/file-stream-upload
# SUNO_COVER_URL=https://example.com/api/v1/generate/upload-cover
# SUNO_STATUS_URL=https://example.com/api/v1/generate/record-info
# SUNO_UPLOAD_PATH=/api/file-stream-upload
# SUNO_FILE_UPLOAD_PATH=audio/user-uploads
# SUNO_COVER_PATH=/api/v1/generate/upload-cover
# SUNO_STATUS_PATH=/api/v1/generate/record-info
# SUNO_AUDIO_URL_FIELD=uploadUrl
